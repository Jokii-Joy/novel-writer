<?xml version="1.0" encoding="utf-8"?>
<!-- Borderless-feeling text button feedback: a ripple that fades out at the
     edges instead of a grey rectangle. Used by ＋, 同步, AI 校对 and the symbol
     keys, all of which are plain text on paper. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/nw_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#ffffff" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>
