# Local toolchain (PortableGit, downloaded by setup-github.cmd) and the GitHub
# token that script stores next to it — neither may ever be committed.
.tools/

# Editor / OS noise
Thumbs.db
desktop.ini
.DS_Store

# APK signing side-output (regenerated on every build-apk run)
dist/*.idsig

# Scratch workspace of scripts/verify-host.mjs (a crashed run can leave it)
scripts/.tmp/

# Android build scratch: tools/build-apk.mjs unpacks classes.dex and res-*.zip
# here while it assembles dist/精神空间.apk, and a crashed run leaves it behind.
.tmp/

# Node leftovers (the plugin itself ships no node_modules)
node_modules/
npm-debug.log*
